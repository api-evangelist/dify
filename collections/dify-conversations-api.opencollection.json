{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dify Chat Conversations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List conversations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dify.ai/v1/conversations",
            "params": [
              {
                "name": "user",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List conversations"
        },
        {
          "info": {
            "name": "Delete a conversation",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.dify.ai/v1/conversations/:conversation_id",
            "params": [
              {
                "name": "conversation_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a conversation"
        },
        {
          "info": {
            "name": "Rename a conversation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dify.ai/v1/conversations/:conversation_id/name",
            "params": [
              {
                "name": "conversation_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Rename a conversation"
        }
      ]
    }
  ],
  "bundled": true
}